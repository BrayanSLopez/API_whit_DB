# ==========================================
# Configuración de Base de Datos
# ==========================================
# URL de conexión a MySQL (dejar vacío para usar SQLite local)
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_db
MYSQL_URI=mysql+pymysql://usuario:contraseña@localhost:3306/nombre_db

# ==========================================
# Configuración de JWT (Autenticación)
# ==========================================
# Clave secreta para firmar los tokens JWT
# Generar una clave segura: openssl rand -hex 32
JWT_SECRET_KEY=tu_clave_secreta_aleatoria_super_segura

# Ubicación del token en la solicitud (headers, cookies, json, query)
JWT_TOKEN_LOCATION=headers

# Tiempo de expiración del token en segundos (2400 = 40 minutos)
JWT_ACCESS_TOKEN_EXPIRES=2400

# Nombre del header donde se encuentra el token
JWT_HEADER_NAME=Authorization

# Tipo de encabezado del token (ej: Bearer)
JWT_HEADER_TYPE=Bearer

# ==========================================
# Configuración de la Aplicación
# ==========================================
# Modo de depuración (True para desarrollo, False para producción)
FLASK_DEBUG=False

# Entorno (development, production, testing)
FLASK_ENV=production
